<%= turbo_frame_tag @product do %>
  <%= link_to products_path, class: "back-link" do %><%= icon("arrow-left") %> Back to catalog<% end %>

  <div class="product-show">
    <div class="product-image-section">
      <% if @product.image.attached? %>
        <%= image_tag @product.image.variant(resize_to_limit: [500, 500]) if @product.image.variable? %>
      <% end %>
    </div>

    <div class="product-details">
      <h1><%= @product.name %></h1>

      <div class="product-meta">
        <div class="product-meta-item">
          <dt><%= icon("tag") %> <%= t("labels.price") %></dt>
          <dd><%= number_to_currency @product.price %></dd>
        </div>
        <div class="product-meta-item">
          <dt><%= icon("package") %> <%= t("labels.stock") %></dt>
          <dd><%= @product.stock_quantity %> <%= t("labels.units") %></dd>
        </div>
        <div class="product-meta-item">
          <dt><%= icon("category") %> <%= t("labels.category") %></dt>
          <dd><%= @product.category.name %></dd>
        </div>
        <div class="product-meta-item">
          <dt><%= t("labels.sku") %></dt>
          <dd><%= @product.sku %></dd>
        </div>
      </div>

      <% if @product.description.present? %>
        <div class="product-description">
          <h2><%= t("labels.description") %></h2>
          <p><%= @product.description %></p>
        </div>
      <% end %>

      <div class="product-actions">
        <%= button_to add_item_cart_path(product_id: @product.id), class: "btn btn-primary" do %><%= icon("shopping-cart") %> <%= t("labels.add_to_cart") %><% end %>
      </div>
    </div>
  </div>
<% end %>
