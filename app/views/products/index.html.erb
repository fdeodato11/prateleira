<%= turbo_frame_tag "products" do %>
  <div class="catalog-header">
    <h1 class="catalog-title"><%= t("labels.products") %></h1>
    <% if @products.any? %>
      <p class="catalog-count"><%= @pagy.count %> <%= t("labels.products_found").downcase %></p>
    <% end %>
  </div>

  <%= form_tag products_path, method: :get, data: { turbo_frame: "products", turbo_action: "advance" }, class: "search-bar" do %>
    <div class="search-bar__field search-bar__query">
      <%= icon("search") %>
      <%= search_field_tag :query, params[:query], placeholder: t("labels.search_products") %>
    </div>

    <div class="search-bar__field">
      <%= select_tag :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), include_blank: t("labels.all_categories") %>
    </div>

    <div class="search-bar__field search-bar__price">
      <%= number_field_tag :price_min, params[:price_min], placeholder: t("labels.min_price"), step: 0.01 %>
      <span class="search-bar__separator">—</span>
      <%= number_field_tag :price_max, params[:price_max], placeholder: t("labels.max_price"), step: 0.01 %>
    </div>

    <div class="search-bar__field">
      <%= select_tag :sort, options_for_select([
        [t("labels.newest"), "newest"],
        [t("labels.oldest"), "oldest"],
        [t("labels.price_low_to_high"), "price_asc"],
        [t("labels.price_high_to_low"), "price_desc"],
        [t("labels.name_az"), "name_asc"],
        [t("labels.name_za"), "name_desc"]
      ], params[:sort]), include_blank: t("labels.sort_by") %>
    </div>

    <div class="search-bar__actions">
      <%= submit_tag t("labels.search"), class: "btn btn-primary" %>
      <% if params[:query].present? || params[:category_id].present? || params[:price_min].present? || params[:price_max].present? || params[:sort].present? %>
        <%= link_to t("labels.clear"), products_path, class: "btn btn-ghost" %>
      <% end %>
    </div>
  <% end %>

  <% if @products.any? %>
    <div class="products-grid">
      <% @products.each do |product| %>
        <%= link_to product, class: "product-card" do %>
          <div class="product-card__image">
            <% if product.image.attached? %>
              <%= image_tag product.image.variant(resize_to_limit: [260, 260]), alt: product.name, loading: "lazy" %>
            <% else %>
              <div class="product-card__no-image">
                <%= icon("image", size: 40) %>
              </div>
            <% end %>
            <% if product.source.present? %>
              <span class="source-badge source-<%= product.source %>"><%= t("labels.#{product.source}", default: product.source.humanize) %></span>
            <% end %>
          </div>
          <div class="product-card__body">
            <p class="product-card__category"><%= product.category.name %></p>
            <h3 class="product-card__name"><%= product.name %></h3>
            <div class="product-card__pricing">
              <% if product.original_price.present? && product.original_price > product.price %>
                <span class="price-original"><%= number_to_currency product.original_price %></span>
              <% end %>
              <span class="price-current"><%= number_to_currency product.price %></span>
            </div>
            <div class="product-card__meta">
              <span class="product-card__stock"><%= icon("package", size: 14) %> <%= product.stock_quantity %> <%= t("labels.in_stock") %></span>
              <% if product.rating.present? && product.rating > 0 %>
                <span class="product-card__rating"><%= icon("star", size: 14) %> <%= product.rating %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="pagination-footer">
      <%= pagy_custom_nav(@pagy) %>
      <p class="pagination-info"><%= t("labels.showing") %> <%= @pagy.from %>-<%= @pagy.to %> <%= t("labels.of") %> <%= @pagy.count %></p>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state__icon"><%= icon("search", size: 48) %></div>
      <p class="empty-state__title"><%= t("labels.no_products_found_criteria") %></p>
      <p class="empty-state__text"><%= t("labels.try_adjusting_filters") %></p>
      <%= link_to t("labels.clear_filters"), products_path, class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
