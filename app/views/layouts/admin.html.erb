<!DOCTYPE html>
<html>
  <head>
    <title>Admin - Prateleira Virtual</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="admin-layout">
      <aside class="admin-sidebar">
        <%= link_to "Prateleira Virtual", root_path, class: "sidebar-logo" %>
        <nav>
          <%= link_to "Dashboard", admin_dashboard_path %>
          <%= link_to "Products", admin_products_path %>
          <%= link_to "Categories", admin_categories_path %>
          <%= link_to "Users", admin_users_path %>
          <%= button_to "Logout", session_path, method: :delete, class: "btn btn-sm", form_class: "inline-form" %>
        </nav>
      </aside>

      <div class="admin-main">
        <% if notice %>
          <div class="flash flash-notice"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="flash flash-alert"><%= alert %></div>
        <% end %>

        <%= yield %>
      </div>
    </div>
  </body>
</html>
