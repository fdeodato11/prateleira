<!DOCTYPE html>
<html>
  <head>
    <title>Admin - Prateleira Virtual</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="admin-layout">
      <aside class="admin-sidebar">
        <%= link_to "Prateleira Virtual", root_path, class: "sidebar-logo" %>
        <nav>
          <%= link_to admin_dashboard_path do %><%= icon("dashboard") %> Dashboard<% end %>
          <%= link_to admin_products_path do %><%= icon("package") %> Products<% end %>
          <%= link_to admin_categories_path do %><%= icon("category") %> Categories<% end %>
          <%= link_to admin_users_path do %><%= icon("users") %> Users<% end %>
          <%= button_to session_path, method: :delete, class: "btn btn-sm", form_class: "inline-form" do %><%= icon("logout") %> Logout<% end %>
        </nav>
      </aside>

      <div class="admin-main">
        <% if notice %>
          <div class="flash flash-notice"><%= icon("check-circle") %><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="flash flash-alert"><%= icon("alert-triangle") %><%= alert %></div>
        <% end %>

        <%= yield %>
      </div>
    </div>
  </body>
</html>
