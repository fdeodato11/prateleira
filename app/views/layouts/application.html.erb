<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Prateleira Virtual" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="public-header">
      <div class="header-inner">
        <%= link_to "Prateleira Virtual", root_path, class: "logo" %>
        <nav>
          <%= link_to "Products", products_path %>
          <%= link_to "Cart", cart_path %>
          <% if authenticated? %>
            <%= link_to "Admin", admin_dashboard_path %>
            <%= button_to "Logout", session_path, method: :delete, class: "btn btn-sm", form_class: "inline-form" %>
          <% else %>
            <%= link_to "Login", new_session_path %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice %>
      <div class="main-content" style="padding-bottom:0"><div class="flash flash-notice"><%= notice %></div></div>
    <% end %>
    <% if alert %>
      <div class="main-content" style="padding-bottom:0"><div class="flash flash-alert"><%= alert %></div></div>
    <% end %>

    <main class="main-content">
      <%= yield %>
    </main>
  </body>
</html>
