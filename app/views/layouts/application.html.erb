<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Prateleira Virtual" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="public-header">
      <div class="header-inner">
        <%= link_to "Prateleira Virtual", root_path, class: "logo" %>
        <nav>
          <%= link_to products_path do %><%= icon("package") %> <%= t("labels.products") %><% end %>
          <%= link_to cart_path do %><%= icon("cart") %> <%= t("labels.cart") %><% end %>
          <% if authenticated? %>
            <%= link_to admin_dashboard_path do %><%= icon("layout-dashboard") %> <%= t("labels.admin") %><% end %>
            <%= button_to session_path, method: :delete, class: "btn btn-sm", form_class: "inline-form" do %><%= icon("logout") %> <%= t("labels.logout") %><% end %>
          <% else %>
            <%= link_to new_session_path do %><%= icon("user") %> <%= t("labels.login") %><% end %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice %>
      <div class="main-content" style="padding-bottom:0"><div class="flash flash-notice"><%= icon("check-circle") %><%= notice %></div></div>
    <% end %>
    <% if alert %>
      <div class="main-content" style="padding-bottom:0"><div class="flash flash-alert"><%= icon("alert-triangle") %><%= alert %></div></div>
    <% end %>

    <main class="main-content">
      <%= yield %>
    </main>
  </body>
</html>
