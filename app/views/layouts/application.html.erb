<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Prateleira Virtual" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-prefetch" content="false">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to root_path, class: "site-header__logo" do %>
          <span class="site-header__logo-icon"><%= icon("box", size: 24) %></span>
          <span class="site-header__logo-text">Prateleira Virtual</span>
        <% end %>

        <nav class="site-header__nav">
          <%= link_to products_path, class: "nav-link" do %>
            <%= icon("package", size: 18) %>
            <span><%= t("labels.products") %></span>
          <% end %>

          <%= link_to cart_path, class: "nav-link nav-link--cart" do %>
            <%= icon("shopping-cart", size: 18) %>
            <span><%= t("labels.cart") %></span>
          <% end %>

          <% if authenticated? %>
            <%= link_to admin_dashboard_path, class: "nav-link nav-link--admin" do %>
              <%= icon("layout-dashboard", size: 18) %>
              <span><%= t("labels.admin") %></span>
            <% end %>

            <%= button_to session_path,
                method: :delete,
                class: "nav-link nav-link--logout",
                form_class: "inline-form" do %>
              <%= icon("logout", size: 18) %>
              <span><%= t("labels.logout") %></span>
            <% end %>
          <% else %>
            <%= link_to new_session_path, class: "nav-link" do %>
              <%= icon("user", size: 18) %>
              <span><%= t("labels.login") %></span>
            <% end %>
          <% end %>
        </nav>

        <button type="button" class="site-header__toggle" data-action="click->navigation#toggle" aria-label="Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <% if notice %>
      <div class="flash-container">
        <div class="flash flash-notice">
          <%= icon("check-circle", size: 18) %>
          <span><%= notice %></span>
          <button type="button" class="flash__close" data-action="click->parentElement.remove()"><%= icon("x", size: 16) %></button>
        </div>
      </div>
    <% end %>
    <% if alert %>
      <div class="flash-container">
        <div class="flash flash-alert">
          <%= icon("alert-triangle", size: 18) %>
          <span><%= alert %></span>
          <button type="button" class="flash__close" data-action="click->parentElement.remove()"><%= icon("x", size: 16) %></button>
        </div>
      </div>
    <% end %>

    <main class="main-content">
      <%= yield %>
    </main>
  </body>
</html>
