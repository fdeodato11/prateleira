<div class="auth-page">
  <div class="auth-card">
    <h1>Sign In</h1>
    <div class="form-card">
      <%= form_with url: session_path do |form| %>
        <div class="form-group">
          <%= form.label :email_address %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
        </div>

        <div class="form-group">
          <%= form.label :password %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
        </div>

        <div class="form-actions">
          <%= form.submit "Sign In", class: "btn btn-primary", style: "width:100%" %>
        </div>
      <% end %>

      <div class="auth-links">
        <%= link_to "Forgot your password?", new_password_path %><br>
        <%= link_to "Don't have an account? Sign up", new_registration_path %>
      </div>
    </div>
  </div>
</div>
