<div class="auth-page">
  <div class="auth-card">
    <h1><%= icon("user", size: 28) %> <%= t("labels.sign_in") %></h1>
    <div class="form-card">
      <%= form_with url: session_path do |form| %>
        <div class="form-group">
          <%= form.label :email_address %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
        </div>

        <div class="form-group">
          <%= form.label :password %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
        </div>

        <div class="form-actions">
          <%= form.button class: "btn btn-primary", style: "width:100%" do %><%= icon("user") %> <%= t("labels.sign_in") %><% end %>
        </div>
      <% end %>

      <div class="auth-links">
        <%= link_to new_password_path do %><%= icon("arrow-left") %> <%= t("labels.forgot_password") %><% end %><br>
        <%= link_to new_registration_path do %><%= icon("user") %> <%= t("labels.dont_have_account_sign_up") %><% end %>
      </div>
    </div>
  </div>
</div>
