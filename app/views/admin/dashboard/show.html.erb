<h1>Dashboard</h1>

<div class="dashboard-stats">
  <div>
    <h3><%= @total_products %></h3>
    <p>Total Products</p>
  </div>
  <div>
    <h3><%= @active_products %></h3>
    <p>Active</p>
  </div>
  <div>
    <h3><%= @draft_products %></h3>
    <p>Drafts</p>
  </div>
  <div>
    <h3><%= @discarded_products %></h3>
    <p>Deleted</p>
  </div>
  <div>
    <h3><%= @total_categories %></h3>
    <p>Categories</p>
  </div>
  <div>
    <h3><%= @total_users %></h3>
    <p>Users</p>
  </div>
</div>

<div class="dashboard-charts">
  <div>
    <h2>Products by Category</h2>
    <%= column_chart @products_by_category, height: "250px", colors: ["#2563eb"] %>
  </div>

  <div>
    <h2>Products by Status</h2>
    <%= pie_chart @products_by_status, height: "250px", colors: ["#10b981", "#f59e0b", "#ef4444", "#6b7280"] %>
  </div>
</div>

<h2>Quick Actions</h2>
<div class="quick-actions">
  <%= link_to "New Product", new_admin_product_path, class: "btn" %>
  <%= link_to "New Category", new_admin_category_path, class: "btn" %>
  <%= link_to "Manage Products", admin_products_path, class: "btn" %>
  <%= link_to "Manage Categories", admin_categories_path, class: "btn" %>
</div>

<h2>Recent Products</h2>
<ul>
  <% @recent_products.each do |product| %>
    <li><%= link_to product.name, admin_product_path(product) %> - <%= number_to_currency product.price %></li>
  <% end %>
</ul>

<% if @low_stock_products.any? %>
  <h2>Low Stock Alert</h2>
  <ul>
    <% @low_stock_products.each do |product| %>
      <li><%= link_to product.name, admin_product_path(product) %> - <%= product.stock_quantity %> units remaining</li>
    <% end %>
  </ul>
<% end %>
