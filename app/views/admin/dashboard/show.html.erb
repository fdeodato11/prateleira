<div class="admin-header">
  <h1><%= icon("dashboard", size: 28) %> Dashboard</h1>
</div>

<div class="dashboard-stats">
  <div class="stat-card">
    <%= icon("package", size: 24) %>
    <h3><%= @total_products %></h3>
    <p>Total Products</p>
  </div>
  <div class="stat-card">
    <%= icon("check-circle", size: 24) %>
    <h3><%= @active_products %></h3>
    <p>Active</p>
  </div>
  <div class="stat-card">
    <%= icon("edit", size: 24) %>
    <h3><%= @draft_products %></h3>
    <p>Drafts</p>
  </div>
  <div class="stat-card">
    <%= icon("trash", size: 24) %>
    <h3><%= @discarded_products %></h3>
    <p>Deleted</p>
  </div>
  <div class="stat-card">
    <%= icon("category", size: 24) %>
    <h3><%= @total_categories %></h3>
    <p>Categories</p>
  </div>
  <div class="stat-card">
    <%= icon("users", size: 24) %>
    <h3><%= @total_users %></h3>
    <p>Users</p>
  </div>
</div>

<div class="dashboard-charts">
  <div class="chart-card">
    <h2>Products by Category</h2>
    <%= column_chart @products_by_category, height: "250px", colors: ["#2563eb"] %>
  </div>
  <div class="chart-card">
    <h2>Products by Status</h2>
    <%= pie_chart @products_by_status, height: "250px", colors: ["#10b981", "#f59e0b", "#ef4444", "#6b7280"] %>
  </div>
</div>

<h2>Quick Actions</h2>
<div class="quick-actions">
  <%= link_to new_admin_product_path, class: "btn btn-primary" do %><%= icon("plus") %> New Product<% end %>
  <%= link_to new_admin_category_path, class: "btn btn-primary" do %><%= icon("plus") %> New Category<% end %>
  <%= link_to admin_products_path, class: "btn" do %><%= icon("package") %> Manage Products<% end %>
  <%= link_to admin_categories_path, class: "btn" do %><%= icon("category") %> Manage Categories<% end %>
</div>

<h2>Recent Products</h2>
<div class="table-container">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Price</th>
      </tr>
    </thead>
    <tbody>
      <% @recent_products.each do |product| %>
        <tr>
          <td><%= link_to product.name, admin_product_path(product) %></td>
          <td><%= number_to_currency product.price %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @low_stock_products.any? %>
  <h2><%= icon("alert-triangle") %> Low Stock Alert</h2>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Stock</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @low_stock_products.each do |product| %>
          <tr>
            <td><%= link_to product.name, admin_product_path(product) %></td>
            <td><%= product.stock_quantity %> units</td>
            <td><%= link_to edit_admin_product_path(product), class: "btn btn-sm" do %><%= icon("edit") %> Edit<% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
