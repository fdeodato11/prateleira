<%= form_with model: [:admin, product], local: true do |f| %>
  <% if product.errors.any? %>
    <div>
      <h2><%= pluralize(product.errors.count, "error") %> prohibited this product from being saved:</h2>
      <ul>
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name %>
    <%= f.text_field :name, required: true %>
  </div>

  <div>
    <%= f.label :description %>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.label :category_id %>
    <%= f.collection_select :category_id, Category.kept.ordered, :id, :name, prompt: "Select Category" %>
  </div>

  <div>
    <%= f.label :price %>
    <%= f.number_field :price, step: 0.01, min: 0, required: true %>
  </div>

  <div>
    <%= f.label :stock_quantity %>
    <%= f.number_field :stock_quantity, min: 0, required: true %>
  </div>

  <div>
    <%= f.label :sku %>
    <%= f.text_field :sku, required: true %>
  </div>

  <div>
    <%= f.label :status %>
    <%= f.select :status, Product.statuses.keys.map { |s| [s.humanize, s] } %>
  </div>

  <div>
    <%= f.label :featured %>
    <%= f.check_box :featured %>
  </div>

  <div>
    <%= f.label :weight %>
    <%= f.number_field :weight, step: 0.01 %>
  </div>

  <div>
    <%= f.label :image %>
    <%= f.file_field :image, accept: "image/jpeg,image/png,image/webp" %>
    <% if product.image.attached? %>
      <p>Current image: <%= image_tag product.image.variant(resize_to_limit: [200, 200]) if product.image.variable? %></p>
    <% end %>
  </div>

  <div>
    <%= f.submit %>
  </div>
<% end %>
