<%= link_to admin_products_path, class: "back-link" do %><%= icon("arrow-left") %> Back to list<% end %>

<div class="detail-card">
  <div class="detail-header">
    <h1><%= @product.name %></h1>
  </div>

  <div class="detail-body">
    <div class="detail-grid">
      <div class="detail-field">
        <dt><%= t("labels.category") %></dt>
        <dd><%= @product.category.name %></dd>
      </div>
      <div class="detail-field">
        <dt><%= t("labels.price") %></dt>
        <dd><%= number_to_currency @product.price %></dd>
      </div>
      <div class="detail-field">
        <dt><%= t("labels.stock") %></dt>
        <dd><%= @product.stock_quantity %> <%= t("labels.units") %></dd>
      </div>
      <div class="detail-field">
        <dt><%= t("labels.sku") %></dt>
        <dd><%= @product.sku %></dd>
      </div>
      <div class="detail-field">
        <dt><%= t("labels.status") %></dt>
        <dd><span class="status-badge status-<%= @product.status %>"><%= @product.status.humanize %></span></dd>
      </div>
      <div class="detail-field">
        <dt><%= t("labels.featured") %></dt>
        <dd><%= @product.featured? ? t("labels.yes") : t("labels.no") %></dd>
      </div>
      <div class="detail-field">
        <dt><%= t("labels.weight") %></dt>
        <dd><%= @product.weight %> g</dd>
      </div>
      <div class="detail-field">
        <dt><%= t("labels.created") %></dt>
        <dd><%= l @product.created_at, format: :long %></dd>
      </div>
      <div class="detail-field">
        <dt><%= t("labels.updated") %></dt>
        <dd><%= l @product.updated_at, format: :long %></dd>
      </div>
      <% if @product.discarded? %>
        <div class="detail-field">
          <dt><%= t("labels.discarded_at") %></dt>
          <dd><%= l @product.discarded_at, format: :long %></dd>
        </div>
      <% end %>
    </div>

    <% if @product.description.present? %>
      <h2><%= t("labels.description") %></h2>
      <p><%= @product.description %></p>
    <% end %>

    <% if @product.image.attached? %>
      <h2><%= t("labels.image") %></h2>
      <%= image_tag @product.image.variant(resize_to_limit: [400, 400]) if @product.image.variable?, class: "detail-image" %>
    <% end %>
  </div>

  <div class="detail-actions">
    <%= link_to edit_admin_product_path(@product), class: "btn btn-primary" do %><%= icon("edit") %> <%= t("labels.edit") %><% end %>
    <% if @product.discarded? %>
      <%= button_to restore_admin_product_path(@product), method: :post, class: "btn" do %><%= icon("refresh") %> <%= t("labels.restore") %><% end %>
    <% else %>
      <%= button_to admin_product_path(@product), method: :delete, data: { confirm: t("labels.are_you_sure") }, class: "btn btn-danger" do %><%= icon("trash") %> <%= t("labels.delete") %><% end %>
    <% end %>
  </div>
</div>
