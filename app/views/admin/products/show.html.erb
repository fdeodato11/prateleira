<%= link_to admin_products_path, class: "back-link" do %><%= icon("arrow-left") %> Back to list<% end %>

<div class="detail-card">
  <div class="detail-header">
    <h1><%= @product.name %></h1>
  </div>

  <div class="detail-body">
    <div class="detail-grid">
      <div class="detail-field">
        <dt>Category</dt>
        <dd><%= @product.category.name %></dd>
      </div>
      <div class="detail-field">
        <dt>Price</dt>
        <dd><%= number_to_currency @product.price %></dd>
      </div>
      <div class="detail-field">
        <dt>Stock</dt>
        <dd><%= @product.stock_quantity %> units</dd>
      </div>
      <div class="detail-field">
        <dt>SKU</dt>
        <dd><%= @product.sku %></dd>
      </div>
      <div class="detail-field">
        <dt>Status</dt>
        <dd><span class="status-badge status-<%= @product.status %>"><%= @product.status.humanize %></span></dd>
      </div>
      <div class="detail-field">
        <dt>Featured</dt>
        <dd><%= @product.featured? ? "Yes" : "No" %></dd>
      </div>
      <div class="detail-field">
        <dt>Weight</dt>
        <dd><%= @product.weight %> g</dd>
      </div>
      <div class="detail-field">
        <dt>Created</dt>
        <dd><%= l @product.created_at, format: :long %></dd>
      </div>
      <div class="detail-field">
        <dt>Updated</dt>
        <dd><%= l @product.updated_at, format: :long %></dd>
      </div>
      <% if @product.discarded? %>
        <div class="detail-field">
          <dt>Discarded at</dt>
          <dd><%= l @product.discarded_at, format: :long %></dd>
        </div>
      <% end %>
    </div>

    <% if @product.description.present? %>
      <h2>Description</h2>
      <p><%= @product.description %></p>
    <% end %>

    <% if @product.image.attached? %>
      <h2>Image</h2>
      <%= image_tag @product.image.variant(resize_to_limit: [400, 400]) if @product.image.variable?, class: "detail-image" %>
    <% end %>
  </div>

  <div class="detail-actions">
    <%= link_to edit_admin_product_path(@product), class: "btn btn-primary" do %><%= icon("edit") %> Edit<% end %>
    <% if @product.discarded? %>
      <%= button_to restore_admin_product_path(@product), method: :post, class: "btn" do %><%= icon("refresh") %> Restore<% end %>
    <% else %>
      <%= button_to admin_product_path(@product), method: :delete, data: { confirm: "Are you sure you want to delete this product?" }, class: "btn btn-danger" do %><%= icon("trash") %> Delete<% end %>
    <% end %>
  </div>
</div>
