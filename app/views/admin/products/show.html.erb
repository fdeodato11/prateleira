<h1><%= @product.name %></h1>

<p><strong>Category:</strong> <%= @product.category.name %></p>
<p><strong>Price:</strong> <%= number_to_currency @product.price %></p>
<p><strong>Stock:</strong> <%= @product.stock_quantity %> units</p>
<p><strong>SKU:</strong> <%= @product.sku %></p>
<p><strong>Status:</strong> <%= @product.status.humanize %></p>
<p><strong>Featured:</strong> <%= @product.featured? ? "Yes" : "No" %></p>
<p><strong>Weight:</strong> <%= @product.weight %> g</p>
<p><strong>Created:</strong> <%= l @product.created_at, format: :long %></p>
<p><strong>Updated:</strong> <%= l @product.updated_at, format: :long %></p>

<% if @product.discarded? %>
  <p><strong>Discarded at:</strong> <%= l @product.discarded_at, format: :long %></p>
<% end %>

<% if @product.description.present? %>
  <h2>Description</h2>
  <p><%= @product.description %></p>
<% end %>

<% if @product.image.attached? %>
  <h2>Image</h2>
  <%= image_tag @product.image if @product.image.variable? %>
<% end %>

<div>
  <%= link_to "Edit", edit_admin_product_path(@product) %>
  <% if @product.discarded? %>
    <%= button_to "Restore", restore_admin_product_path(@product), method: :post %>
  <% else %>
    <%= button_to "Delete", admin_product_path(@product), method: :delete, data: { confirm: "Are you sure you want to delete this product?" } %>
  <% end %>
  <%= link_to "Back to list", admin_products_path %>
</div>
