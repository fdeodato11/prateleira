<div class="admin-header">
  <h1><%= icon("package", size: 28) %> <%= t("labels.products") %></h1>
  <div class="admin-actions">
    <%= link_to new_admin_product_path, class: "btn btn-primary" do %><%= icon("plus") %> <%= t("labels.new_product") %><% end %>
  </div>
</div>

<%= form_tag admin_products_path, method: :get, class: "search-bar" do %>
  <%= icon("search") %>
  <%= search_field_tag :query, params[:query], placeholder: t("labels.search") %>
  <%= select_tag :category_id, options_from_collection_for_select(Category.kept.ordered, :id, :name, params[:category_id]), include_blank: t("labels.all_categories") %>
  <%= select_tag :status, options_for_select(Product.statuses.keys.map { |s| [s.humanize, s] }, params[:status]), include_blank: t("labels.all_statuses") %>
  <%= button_tag class: "btn btn-primary" do %><%= icon("filter") %> <%= t("labels.filter") %><% end %>
<% end %>

<% if @products.any? %>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th><%= t("labels.image") %></th>
          <th><%= t("labels.name") %></th>
          <th><%= t("labels.category") %></th>
          <th><%= t("labels.price") %></th>
          <th><%= t("labels.stock") %></th>
          <th><%= t("labels.status") %></th>
          <th><%= t("labels.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td>
              <% if product.image.attached? %>
                <%= image_tag product.image.variant(resize_to_limit: [40, 40]), class: "thumbnail" %>
              <% end %>
            </td>
            <td><%= link_to product.name, admin_product_path(product) %></td>
            <td><%= product.category.name %></td>
            <td><%= number_to_currency product.price %></td>
            <td><%= product.stock_quantity %></td>
            <td><span class="status-badge status-<%= product.status %>"><%= product.status.humanize %></span></td>
            <td>
              <div class="btn-group">
                <%= link_to edit_admin_product_path(product), class: "btn btn-sm" do %><%= icon("edit") %> <%= t("labels.edit") %><% end %>
                <% if product.discarded? %>
                  <%= button_to restore_admin_product_path(product), method: :post, class: "btn btn-sm" do %><%= icon("refresh") %> <%= t("labels.restore") %><% end %>
                <% else %>
                  <%= button_to admin_product_path(product), method: :delete, data: { confirm: t("labels.are_you_sure") }, class: "btn btn-sm btn-danger" do %><%= icon("trash") %> <%= t("labels.delete") %><% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%== pagy_nav(@pagy) %>
<% else %>
    <div class="empty-state">
      <%= icon("package", css_class: "icon-lg", size: 48) %>
      <p><%= t("labels.no_products_found") %></p>
    </div>
<% end %>
