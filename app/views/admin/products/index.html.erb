<div class="admin-header">
  <h1><%= icon("package", size: 28) %> Products</h1>
  <div class="admin-actions">
    <%= link_to new_admin_product_path, class: "btn btn-primary" do %><%= icon("plus") %> New Product<% end %>
  </div>
</div>

<%= form_tag admin_products_path, method: :get, class: "search-bar" do %>
  <%= icon("search") %>
  <%= search_field_tag :query, params[:query], placeholder: "Search..." %>
  <%= select_tag :category_id, options_from_collection_for_select(Category.kept.ordered, :id, :name, params[:category_id]), include_blank: "All Categories" %>
  <%= select_tag :status, options_for_select(Product.statuses.keys.map { |s| [s.humanize, s] }, params[:status]), include_blank: "All Statuses" %>
  <%= button_tag class: "btn btn-primary" do %><%= icon("filter") %> Filter<% end %>
<% end %>

<% if @products.any? %>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Image</th>
          <th>Name</th>
          <th>Category</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td>
              <% if product.image.attached? %>
                <%= image_tag product.image.variant(resize_to_limit: [40, 40]), class: "thumbnail" %>
              <% end %>
            </td>
            <td><%= link_to product.name, admin_product_path(product) %></td>
            <td><%= product.category.name %></td>
            <td><%= number_to_currency product.price %></td>
            <td><%= product.stock_quantity %></td>
            <td><span class="status-badge status-<%= product.status %>"><%= product.status.humanize %></span></td>
            <td>
              <div class="btn-group">
                <%= link_to edit_admin_product_path(product), class: "btn btn-sm" do %><%= icon("edit") %> Edit<% end %>
                <% if product.discarded? %>
                  <%= button_to restore_admin_product_path(product), method: :post, class: "btn btn-sm" do %><%= icon("refresh") %> Restore<% end %>
                <% else %>
                  <%= button_to admin_product_path(product), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" do %><%= icon("trash") %> Delete<% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%== pagy_nav(@pagy) %>
<% else %>
    <div class="empty-state">
      <%= icon("package", css_class: "icon-lg", size: 48) %>
      <p>No products found.</p>
    </div>
<% end %>
