<%= link_to admin_categories_path, class: "back-link" do %><%= icon("arrow-left") %> Back to categories<% end %>

<div class="detail-card">
  <div class="detail-header">
    <h1><%= @category.name %></h1>
  </div>

  <div class="detail-body">
    <div class="detail-grid">
      <div class="detail-field">
        <dt>Slug</dt>
        <dd><%= @category.slug %></dd>
      </div>
      <div class="detail-field">
        <dt>Description</dt>
        <dd><%= @category.description %></dd>
      </div>
      <div class="detail-field">
        <dt>Products</dt>
        <dd><%= @category.products.kept.count %></dd>
      </div>
    </div>
  </div>

  <div class="detail-actions">
    <%= link_to edit_admin_category_path(@category), class: "btn btn-primary" do %><%= icon("edit") %> Edit<% end %>
    <% if @category.discarded? %>
      <%= button_to restore_admin_category_path(@category), method: :post, class: "btn" do %><%= icon("refresh") %> Restore<% end %>
    <% else %>
      <%= button_to admin_category_path(@category), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger" do %><%= icon("trash") %> Delete<% end %>
    <% end %>
  </div>
</div>
