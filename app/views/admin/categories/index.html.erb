<div class="admin-header">
  <h1><%= icon("category", size: 28) %> Categories</h1>
  <div class="admin-actions">
    <%= link_to new_admin_category_path, class: "btn btn-primary" do %><%= icon("plus") %> New Category<% end %>
  </div>
</div>

<% if @categories.any? %>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Slug</th>
          <th>Products</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <td><%= link_to category.name, admin_category_path(category) %></td>
            <td><%= category.slug %></td>
            <td><%= category.products.kept.count %></td>
            <td><span class="status-badge <%= category.discarded? ? "status-inactive" : "status-active" %>"><%= category.discarded? ? "Discarded" : "Active" %></span></td>
            <td>
              <div class="btn-group">
                <%= link_to edit_admin_category_path(category), class: "btn btn-sm" do %><%= icon("edit") %> Edit<% end %>
                <% if category.discarded? %>
                  <%= button_to restore_admin_category_path(category), method: :post, class: "btn btn-sm" do %><%= icon("refresh") %> Restore<% end %>
                <% else %>
                  <%= button_to admin_category_path(category), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" do %><%= icon("trash") %> Delete<% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
    <div class="empty-state">
      <%= icon("category", css_class: "icon-lg", size: 48) %>
      <p>No categories yet.</p>
      <%= link_to new_admin_category_path, class: "btn btn-primary" do %><%= icon("plus") %> Create your first category<% end %>
    </div>
<% end %>
