<div class="admin-header">
  <h1><%= icon("category", size: 28) %> <%= t("labels.categories") %></h1>
  <div class="admin-actions">
    <%= link_to new_admin_category_path, class: "btn btn-primary" do %><%= icon("plus") %> <%= t("labels.new_category") %><% end %>
  </div>
</div>

<% if @categories.any? %>
  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th><%= t("labels.name") %></th>
          <th><%= t("labels.slug") %></th>
          <th><%= t("labels.products") %></th>
          <th><%= t("labels.status") %></th>
          <th><%= t("labels.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <td><%= link_to category.name, admin_category_path(category) %></td>
            <td><%= category.slug %></td>
            <td><%= category.products.kept.count %></td>
            <td><span class="status-badge <%= category.discarded? ? "status-inactive" : "status-active" %>"><%= category.discarded? ? t("labels.discarded") : t("labels.active") %></span></td>
            <td>
              <div class="btn-group">
                <%= link_to edit_admin_category_path(category), class: "btn btn-sm" do %><%= icon("edit") %> <%= t("labels.edit") %><% end %>
                <% if category.discarded? %>
                  <%= button_to restore_admin_category_path(category), method: :post, class: "btn btn-sm" do %><%= icon("refresh") %> <%= t("labels.restore") %><% end %>
                <% else %>
                  <%= button_to admin_category_path(category), method: :delete, data: { confirm: t("labels.are_you_sure") }, class: "btn btn-sm btn-danger" do %><%= icon("trash") %> <%= t("labels.delete") %><% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
    <div class="empty-state">
      <%= icon("category", css_class: "icon-lg", size: 48) %>
      <p><%= t("labels.no_categories_yet") %></p>
      <%= link_to new_admin_category_path, class: "btn btn-primary" do %><%= icon("plus") %> <%= t("labels.create_first_category") %><% end %>
    </div>
<% end %>
