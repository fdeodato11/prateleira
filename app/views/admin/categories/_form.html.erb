<%= form_with model: [:admin, @category], class: "form-card" do |form| %>
  <% if @category.errors.any? %>
    <div class="form-errors">
      <h2><%= pluralize(@category.errors.count, "error") %> prohibited this category from being saved:</h2>
      <ul>
        <% @category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group<%= " invalid" if @category.errors[:name].any? %>">
    <%= form.label :name %>
    <%= form.text_field :name %>
    <% if @category.errors[:name].any? %>
      <p class="field-error"><%= @category.errors[:name].join(", ") %></p>
    <% end %>
  </div>

  <div class="form-group">
    <%= form.label :slug %>
    <%= form.text_field :slug %>
  </div>

  <div class="form-group">
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_categories_path, class: "btn" %>
  </div>
<% end %>
