<div class="admin-header">
  <h1><%= t("labels.edit_user") %>: <%= @user.email_address %></h1>
  <div class="admin-actions">
    <%= link_to admin_users_path, class: "btn" do %><%= icon("arrow-left") %> Back<% end %>
  </div>
</div>

<div class="form-card">
  <%= form_with model: [:admin, @user] do |form| %>
    <div class="form-group">
      <label class="checkbox-label">
        <%= form.check_box :admin %>
        <%= t("labels.admin") %>
      </label>
    </div>

    <div class="form-actions">
      <%= form.button class: "btn btn-primary" do %><%= icon("check") %> <%= t("labels.update") %><% end %>
      <%= link_to admin_users_path, class: "btn" do %><%= icon("x") %> <%= t("labels.cancel") %><% end %>
    </div>
  <% end %>
</div>
