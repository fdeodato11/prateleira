<%= link_to admin_users_path, class: "back-link" do %><%= icon("arrow-left") %> Back to Users<% end %>

<div class="detail-card">
  <div class="detail-header">
    <h1><%= @user.email_address %></h1>
  </div>

  <div class="detail-body">
    <div class="detail-grid">
      <div class="detail-field">
        <dt>Email</dt>
        <dd><%= @user.email_address %></dd>
      </div>
      <div class="detail-field">
        <dt>Admin</dt>
        <dd><span class="status-badge <%= @user.administrator? ? "status-active" : "status-draft" %>"><%= @user.administrator? ? "Yes" : "No" %></span></dd>
      </div>
      <div class="detail-field">
        <dt>Created</dt>
        <dd><%= l @user.created_at, format: :long %></dd>
      </div>
    </div>
  </div>
</div>
