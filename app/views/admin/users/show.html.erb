<%= link_to admin_users_path, class: "back-link" do %><%= icon("arrow-left") %> Back to Users<% end %>

<div class="detail-card">
  <div class="detail-header">
    <h1><%= @user.email_address %></h1>
  </div>

  <div class="detail-body">
    <div class="detail-grid">
      <div class="detail-field">
        <dt><%= t("labels.email") %></dt>
        <dd><%= @user.email_address %></dd>
      </div>
      <div class="detail-field">
        <dt><%= t("labels.admin") %></dt>
        <dd><span class="status-badge <%= @user.administrator? ? "status-active" : "status-draft" %>"><%= @user.administrator? ? t("labels.yes") : t("labels.no") %></span></dd>
      </div>
      <div class="detail-field">
        <dt><%= t("labels.created") %></dt>
        <dd><%= l @user.created_at, format: :long %></dd>
      </div>
    </div>
  </div>
</div>
