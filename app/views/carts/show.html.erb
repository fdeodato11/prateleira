<div class="cart-page">
  <h1>Shopping Cart</h1>

  <% if @cart.cart_items.any? %>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @cart.cart_items.includes(:product).each do |item| %>
            <tr>
              <td><%= link_to item.product.name, item.product %></td>
              <td><%= number_to_currency item.product.price %></td>
              <td><%= item.quantity %></td>
              <td><%= number_to_currency item.product.price * item.quantity %></td>
              <td>
                <%= button_to "Remove", remove_item_cart_path(product_id: item.product_id), method: :delete, class: "btn btn-danger btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="cart-total-row">
            <td colspan="3">Total</td>
            <td><%= number_to_currency @cart.total %></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="cart-actions">
      <%= link_to "Continue Shopping", products_path, class: "btn" %>
    </div>
  <% else %>
    <div class="cart-empty">
      <p>Your cart is empty.</p>
      <%= link_to "Browse Products", products_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
