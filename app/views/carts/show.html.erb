<div class="cart-page">
  <h1><%= icon("shopping-cart", size: 28) %> <%= t("labels.shopping_cart") %></h1>

  <% if @cart.cart_items.any? %>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th><%= t("labels.product") %></th>
            <th><%= t("labels.price") %></th>
            <th><%= t("labels.quantity") %></th>
            <th><%= t("labels.total") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @cart.cart_items.includes(:product).each do |item| %>
            <tr>
              <td><%= link_to item.product.name, item.product %></td>
              <td><%= number_to_currency item.product.price %></td>
              <td><%= item.quantity %></td>
              <td><%= number_to_currency item.product.price * item.quantity %></td>
              <td>
                <%= button_to remove_item_cart_path(product_id: item.product_id), method: :delete, class: "btn btn-danger btn-sm" do %><%= icon("trash-2") %> <%= t("labels.remove") %><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="cart-total-row">
            <td colspan="3"><%= t("labels.total") %></td>
            <td><%= number_to_currency @cart.total %></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="cart-actions">
      <%= link_to products_path, class: "btn" do %><%= icon("shopping-bag") %> <%= t("labels.continue_shopping") %><% end %>
    </div>
  <% else %>
    <div class="cart-empty">
      <%= icon("cart", css_class: "icon-lg", size: 48) %>
      <p><%= t("labels.cart_empty") %></p>
      <%= link_to products_path, class: "btn btn-primary" do %><%= icon("shopping-bag") %> <%= t("labels.browse_products") %><% end %>
    </div>
  <% end %>
</div>
