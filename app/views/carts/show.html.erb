<h1>Shopping Cart</h1>

<% if @cart.cart_items.any? %>
  <table>
    <thead>
      <tr>
        <th>Product</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Total</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @cart.cart_items.includes(:product).each do |item| %>
        <tr>
          <td><%= link_to item.product.name, item.product %></td>
          <td><%= number_to_currency item.product.price %></td>
          <td><%= item.quantity %></td>
          <td><%= number_to_currency item.product.price * item.quantity %></td>
          <td>
            <%= button_to "Remove", remove_item_cart_path(product_id: item.product_id), method: :delete %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <th colspan="3">Total</th>
        <th><%= number_to_currency @cart.total %></th>
        <th></th>
      </tr>
    </tfoot>
  </table>
<% else %>
  <p>Your cart is empty.</p>
<% end %>

<%= link_to "Continue Shopping", products_path %>
