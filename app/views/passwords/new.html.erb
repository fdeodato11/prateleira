<div class="auth-page">
  <div class="auth-card">
    <h1><%= icon("alert-triangle", size: 28) %> <%= t("labels.forgot_password") %></h1>
    <div class="form-card">
      <%= form_with url: passwords_path do |form| %>
        <div class="form-group">
          <%= form.label :email_address %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
        </div>

        <div class="form-actions">
          <%= form.button class: "btn btn-primary", style: "width:100%" do %><%= icon("refresh") %> <%= t("labels.send_reset_instructions") %><% end %>
        </div>
      <% end %>

      <div class="auth-links">
        <%= link_to new_session_path do %><%= icon("arrow-left") %> <%= t("labels.back_to_sign_in") %><% end %>
      </div>
    </div>
  </div>
</div>
