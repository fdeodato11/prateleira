<div class="auth-page">
  <div class="auth-card">
    <h1>Forgot your password?</h1>
    <div class="form-card">
      <%= form_with url: passwords_path do |form| %>
        <div class="form-group">
          <%= form.label :email_address %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
        </div>

        <div class="form-actions">
          <%= form.submit "Send reset instructions", class: "btn btn-primary", style: "width:100%" %>
        </div>
      <% end %>

      <div class="auth-links">
        <%= link_to "Back to sign in", new_session_path %>
      </div>
    </div>
  </div>
</div>
